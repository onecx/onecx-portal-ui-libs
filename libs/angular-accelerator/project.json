{
  "name": "angular-accelerator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/angular-accelerator/src",
  "prefix": "onecx",
  "projectType": "library",
  "tags": [],
  "targets": {
    "copyOptimuslocaleTranslations": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "mkdir -p libs/angular-accelerator/tmp/optimuslocale",
          "cp node_modules/@openng/optimus-ui-locale/de.json libs/angular-accelerator/tmp/optimuslocale/",
          "cp node_modules/@openng/optimus-ui-locale/en.json libs/angular-accelerator/tmp/optimuslocale/",
          "sed -i 's/\"de\":/\"optimus\":/' libs/angular-accelerator/tmp/optimuslocale/de.json",
          "sed -i 's/\"en\":/\"optimus\":/' libs/angular-accelerator/tmp/optimuslocale/en.json"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "dependsOn": ["^build", "copyOptimuslocaleTranslations"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/angular-accelerator/ng-package.json",
        "tsConfig": "libs/angular-accelerator/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/angular-accelerator/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/angular-accelerator/jest.config.ts",
        "tsConfig": "libs/angular-accelerator/tsconfig.spec.json",
        "codeCoverage": true,
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/angular-accelerator/**/*.ts",
          "libs/angular-accelerator/**/*.html",
          "libs/angular-accelerator/package.json"
        ]
      }
    },
    "release": {
      "executor": "@onecx/release:update-build-publish",
      "options": {
        "buildTarget": "build"
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "libs/angular-accelerator/.storybook",
        "browserTarget": "angular-accelerator:build-storybook",
        "compodoc": false,
        "styles": [
          "node_modules/@openng/icons/openng-icons.css",
          "libs/angular-accelerator/assets/styles.scss",
          "libs/angular-accelerator/.storybook/theme_defaults.scss",
          "libs/angular-accelerator/src/lib/directives/loading-indicator.directive.scss",
          "libs/angular-accelerator/src/lib/directives/content.directive.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/angular-accelerator",
        "configDir": "libs/angular-accelerator/.storybook",
        "browserTarget": "angular-accelerator:build-storybook",
        "compodoc": false,
        "styles": [
          "node_modules/@openng/icons/openng-icons.css",
          "libs/angular-accelerator/assets/styles.scss",
          "libs/angular-accelerator/.storybook/theme_defaults.scss",
          "libs/angular-accelerator/src/lib/directives/loading-indicator.directive.scss",
          "libs/angular-accelerator/src/lib/directives/content.directive.scss"
        ]
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    }
  }
}
